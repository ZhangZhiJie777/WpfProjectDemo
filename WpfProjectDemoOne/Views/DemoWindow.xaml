<Window x:Class="WpfProjectDemoOne.Views.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:theme="https://github.com/Dirkster99/AvalonDock"
        xmlns:local="clr-namespace:WpfProjectDemoOne.Views"
        xmlns:viewmodels="clr-namespace:WpfProjectDemoOne.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodels:DemoViewModel}"        
        mc:Ignorable="d"
        Title="DemoWindow"
        Height="720"
        Width="1280"
        MinHeight="540"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <!-- 统一资源区：集中定义颜色和基础样式，方便后续统一调整界面风格 -->
    <Window.Resources>
        <!-- 整个窗口最外层背景 -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
        <!-- 常规面板背景，例如左右停靠窗口 -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#252526" />
        <!-- 次级面板背景，例如顶部区域和输入框背景 -->
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2D2D30" />
        <!-- 深色边框颜色 -->
        <SolidColorBrush x:Key="BorderBrushDark" Color="#3F3F46" />
        <!-- 主文字颜色 -->
        <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3" />
        <!-- 次级说明文字颜色 -->
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#C8C8C8" />
        <!-- 主题强调色 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0E639C" />
        <!-- 强调色高亮版本 -->
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1177BB" />
        <!-- 中央文档区域背景色 -->
        <SolidColorBrush x:Key="DocumentBrush" Color="#1F1F1F" />

        <!-- 顶部菜单栏的默认样式 -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- 各菜单项的默认样式 -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Window.Resources>

    <!--
        外层 DockPanel:
        顶部放标题栏和菜单栏，底部放状态栏，中间留给 AvalonDock 工作区。
    -->
    <DockPanel Background="{StaticResource WindowBackgroundBrush}">
        <!-- 顶部标题和菜单区域 -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题区：左侧产品说明，右侧版本徽标 -->
                <Grid Grid.Row="0" Margin="16,10,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Demo Studio"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="基于 AvalonDock 的 VS 2022 风格工作台"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>

                    <!-- 版本标签 -->
                    <Border Grid.Column="1"
                            Padding="10,6"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="14"
                            VerticalAlignment="Center">
                        <TextBlock Text="AvalonDock 4.70.0"
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- 菜单栏：所有菜单项在代码后置中均有对应 Click 处理方法 -->
                <Menu Grid.Row="1">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New Workspace" Click="NewWorkspaceMenuItem_Click" />
                        <MenuItem Header="_Open Layout" Click="OpenLayoutMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="_Save Layout" Click="SaveLayoutMenuItem_Click" />
                        <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" Click="UndoMenuItem_Click" />
                        <MenuItem Header="Cu_t" Click="CutMenuItem_Click" />
                        <MenuItem Header="_Copy" Click="CopyMenuItem_Click" />
                        <MenuItem Header="_Paste" Click="PasteMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="_Toolbox" Click="ToolboxMenuItem_Click" />
                        <MenuItem Header="_Solution Explorer" Click="SolutionExplorerMenuItem_Click" />
                        <MenuItem Header="_Properties" Click="PropertiesMenuItem_Click" />
                        <MenuItem Header="_Output" Click="OutputMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="_Run Demo" Click="RunDemoMenuItem_Click" />
                        <MenuItem Header="_Reset Layout" Click="ResetLayoutMenuItem_Click" />
                        <MenuItem Header="_Options" Click="OptionsMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_Welcome" Click="WelcomeMenuItem_Click" />
                        <MenuItem Header="_Support" Click="SupportMenuItem_Click" />
                        <MenuItem Header="_About" Click="AboutMenuItem_Click" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <!-- 底部状态栏：显示当前状态、分支和目标框架等信息 -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{StaticResource SurfaceBrush}"
                   Foreground="{StaticResource SubtleTextBrush}"
                   BorderBrush="{StaticResource BorderBrushDark}"
                   BorderThickness="1,1,1,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="就绪" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="main" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text=".NET 8" />
            </StatusBarItem>
        </StatusBar>

        <!--
            AvalonDock 工作区：
            用来模拟 Visual Studio 风格的 IDE 布局，支持停靠、文档页和工具窗口。
        -->
        <avalonDock:DockingManager x:Name="DockManager" Margin="8" AllowMixedOrientation="True">
            <avalonDock:DockingManager.Theme>
                <!-- 当前停靠主题，可替换为其它 AvalonDock 官方主题 -->
                <theme:GenericTheme/>
            </avalonDock:DockingManager.Theme>

            <avalonDock:LayoutRoot>
                <!-- 最外层纵向分区：上方主工作区，下方输出/错误区域 -->
                <avalonDock:LayoutPanel Orientation="Vertical">
                    <!-- 上方主工作区：左工具箱，中间文档区，右资源管理/属性区 -->
                    <avalonDock:LayoutPanel Orientation="Horizontal">
                        <!-- 左侧工具箱 -->
                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="230">
                            <avalonDock:LayoutAnchorablePane>
                                <avalonDock:LayoutAnchorable x:Name="ToolboxAnchorable"
                                                             Title="Toolbox"
                                                             CanClose="False"
                                                             CanHide="False"
                                                             IsSelected="True">
                                    <!-- 模拟 IDE 工具箱中的常用控件列表 -->
                                    <Border Background="{StaticResource SurfaceBrush}" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="常用控件"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <ListBox Margin="0,10,0,0"
                                                     Background="{StaticResource SurfaceAltBrush}"
                                                     Foreground="{StaticResource TextBrush}"
                                                     BorderBrush="{StaticResource BorderBrushDark}">
                                                <ListBoxItem Content="Button" />
                                                <ListBoxItem Content="TextBox" />
                                                <ListBoxItem Content="ComboBox" />
                                                <ListBoxItem Content="DataGrid" />
                                                <ListBoxItem Content="TreeView" />
                                                <ListBoxItem Content="UserControl" />
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>

                        <!-- 中央文档页签区域 -->
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane x:Name="MainDocumentPane">
                                <!-- 启动页文档：展示工作区介绍信息 -->
                                <avalonDock:LayoutDocument x:Name="StartPageDocument"
                                                           Title="Start Page"
                                                           IsActive="True">
                                    <Border Background="{StaticResource DocumentBrush}" Padding="24">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <!-- 启动页标题和副标题 -->
                                            <StackPanel>
                                                <TextBlock Text="欢迎使用 Demo Studio"
                                                           FontSize="28"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="一个接近 Visual Studio 2022 工作区体验的 AvalonDock 演示页面"
                                                           Margin="0,10,0,0"
                                                           FontSize="14"
                                                           Foreground="{StaticResource SubtleTextBrush}" />
                                            </StackPanel>

                                            <!-- 三张说明卡片，介绍当前工作区的结构特点 -->
                                            <UniformGrid Grid.Row="1"
                                                         Margin="0,24,0,0"
                                                         Rows="1"
                                                         Columns="3">
                                                <Border Margin="0,0,16,0"
                                                        Padding="18"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="12"
                                                        BorderBrush="{StaticResource BorderBrushDark}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Workspace"
                                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="组织文档与工具窗口，支持停靠、拖拽与多标签布局。"
                                                                   Margin="0,8,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="0,0,16,0"
                                                        Padding="18"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="12"
                                                        BorderBrush="{StaticResource BorderBrushDark}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Documents"
                                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="中心区域采用文档页签展示，方便模拟编辑器式工作流。"
                                                                   Margin="0,8,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Padding="18"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="12"
                                                        BorderBrush="{StaticResource BorderBrushDark}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Panels"
                                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="右侧属性、左侧工具箱、底部输出窗口完整呈现 IDE 工作台结构。"
                                                                   Margin="0,8,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <!-- 启动页底部说明条 -->
                                            <Border Grid.Row="2"
                                                    Margin="0,24,0,0"
                                                    Padding="16"
                                                    Background="#26282B"
                                                    CornerRadius="12"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1">
                                                <TextBlock Text="提示: 你可以从顶部菜单触发各个工具窗口的显示、隐藏和布局重置逻辑。"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </avalonDock:LayoutDocument>

                                <!-- 编辑文档：模拟实际业务页面或设计器区域 -->
                                <avalonDock:LayoutDocument x:Name="EditorDocument"
                                                           Title="MainView.xaml">
                                    <Border Background="{StaticResource DocumentBrush}" Padding="18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="设计视图"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />

                                            <!-- 文档预览区域 -->
                                            <Border Grid.Row="1"
                                                    Margin="0,16,0,0"
                                                    Background="#2B2B2E"
                                                    BorderBrush="{StaticResource BorderBrushDark}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <Grid Margin="24">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="Document Preview"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="13" />
                                                    <TextBlock Grid.Row="1"
                                                               Margin="0,12,0,0"
                                                               Text="这里可以替换成你的编辑器、设计器或业务内容区域。"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="16" />
                                                    <ProgressBar Grid.Row="2"
                                                                 Margin="0,18,0,0"
                                                                 Height="8"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="68"
                                                                 Foreground="{StaticResource AccentBrush}"
                                                                 Background="#3C3C40" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </avalonDock:LayoutDocument>
                            </avalonDock:LayoutDocumentPane>
                        </avalonDock:LayoutDocumentPaneGroup>

                        <!-- 右侧停靠窗口：解决方案资源管理器 + 属性面板 -->
                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="280">
                            <avalonDock:LayoutAnchorablePane>
                                <!-- 解决方案资源管理器 -->
                                <avalonDock:LayoutAnchorable x:Name="SolutionExplorerAnchorable"
                                                             Title="Solution Explorer"
                                                             CanClose="False"
                                                             CanHide="False"
                                                             IsSelected="True">
                                    <Border Background="{StaticResource SurfaceBrush}" Padding="12">
                                        <TreeView Background="{StaticResource SurfaceBrush}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  BorderThickness="0">
                                            <TreeView.Resources>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                </Style>
                                            </TreeView.Resources>

                                            <!-- 演示用项目结构树 -->
                                            <TreeViewItem Header="WpfProjectDemoOne" IsExpanded="True" >
                                                <TreeViewItem Header="Views" IsExpanded="True">
                                                    <TreeViewItem Header="DemoWindow.xaml" />
                                                    <TreeViewItem Header="TestWindow.xaml" />
                                                    <TreeViewItem Header="FirstWindow.xaml" />
                                                </TreeViewItem>
                                                <TreeViewItem Header="ViewModels" />
                                                <TreeViewItem Header="Models" />
                                                <TreeViewItem Header="Common" />
                                            </TreeViewItem>
                                        </TreeView>
                                    </Border>
                                </avalonDock:LayoutAnchorable>

                                <!-- 属性窗口 -->
                                <avalonDock:LayoutAnchorable x:Name="PropertiesAnchorable"
                                                             Title="Properties"
                                                             CanClose="False"
                                                             CanHide="False">
                                    <Border Background="{StaticResource SurfaceBrush}" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Name" Foreground="{StaticResource SubtleTextBrush}" />
                                            <TextBox Grid.Column="1" Margin="8,0,0,8" Text="DemoWindow"
                                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextBrush}"
                                                     BorderBrush="{StaticResource BorderBrushDark}" />

                                            <TextBlock Grid.Row="1" Text="Theme" Foreground="{StaticResource SubtleTextBrush}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" Text="Vs2013BlueTheme"
                                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextBrush}"
                                                     BorderBrush="{StaticResource BorderBrushDark}" />

                                            <TextBlock Grid.Row="2" Text="Target" Foreground="{StaticResource SubtleTextBrush}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" Text=".NET 8"
                                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextBrush}"
                                                     BorderBrush="{StaticResource BorderBrushDark}" />

                                            <TextBlock Grid.Row="3" Text="Version" Foreground="{StaticResource SubtleTextBrush}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Margin="8,0,0,0" Text="Dirkster.AvalonDock 4.70.0"
                                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextBrush}"
                                                     BorderBrush="{StaticResource BorderBrushDark}" />
                                        </Grid>
                                    </Border>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>
                    </avalonDock:LayoutPanel>

                    <!-- 底部停靠区域：输出窗口和错误列表 -->
                    <avalonDock:LayoutAnchorablePaneGroup DockHeight="180">
                        <avalonDock:LayoutAnchorablePane>
                            <!-- 输出窗口：用于展示日志、运行状态等信息 -->
                            <avalonDock:LayoutAnchorable x:Name="OutputAnchorable"
                                                         Title="Output"
                                                         CanClose="False"
                                                         CanHide="False"
                                                         IsSelected="True">
                                <Border Background="{StaticResource SurfaceBrush}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Build + Debug" Foreground="{StaticResource SubtleTextBrush}" />
                                        <TextBox Grid.Row="1"
                                                 x:Name="OutputTextBox"
                                                 Margin="0,10,0,0"
                                                 Background="#1B1B1C"
                                                 Foreground="#DCDCDC"
                                                 BorderBrush="{StaticResource BorderBrushDark}"
                                                 FontFamily="Consolas"
                                                 FontSize="13"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="> Demo Studio initialized successfully." />
                                    </Grid>
                                </Border>
                            </avalonDock:LayoutAnchorable>

                            <!-- 错误列表：模拟 IDE 中的错误面板 -->
                            <avalonDock:LayoutAnchorable x:Name="ErrorsAnchorable"
                                                         Title="Error List"
                                                         CanClose="False"
                                                         CanHide="False">
                                <Border Background="{StaticResource SurfaceBrush}" Padding="12">
                                    <ListView Background="{StaticResource SurfaceBrush}"
                                              Foreground="{StaticResource TextBrush}"
                                              BorderBrush="{StaticResource BorderBrushDark}">
                                        <ListViewItem Content="No issues detected." />
                                        <ListViewItem Content="Ready for interaction." />
                                    </ListView>
                                </Border>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
    </DockPanel>
</Window>
